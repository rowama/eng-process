#!/usr/bin/env python3
"""eng-new <type> <slug> [--repo DIR] [--title T] [--summary S] [--section S] [--agent NAME] [--phase P]

Create an artifact from its template with id, date, git metadata. Prints the created path.
Types: design architecture vision adr research market-research brief plan slice handoff review plan-review
       verification retro changelog
'changelog' inserts a complete entry (no placeholders) under '## [Unreleased]' in CHANGELOG.md:
  --summary is the user-facing sentence (default: the title), --section is Added|Changed|Fixed|Removed
  (default Changed)."""
import os, sys, re, argparse
sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import englib as L

ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
ap.add_argument("type", choices=sorted(L.ARTIFACTS))
ap.add_argument("slug")
ap.add_argument("--repo", default=".")
ap.add_argument("--title")
ap.add_argument("--summary")
ap.add_argument("--section", default="Changed", choices=["Added", "Changed", "Fixed", "Removed", "Security"])
ap.add_argument("--agent", default=os.environ.get("ENG_AGENT", "unassigned"))
ap.add_argument("--phase", help="phase for handoff/adr (default: PROJECT_STATE phase)")
a = ap.parse_args()
repo = os.path.abspath(a.repo)
slug = re.sub(r"[^a-z0-9]+", "-", a.slug.lower()).strip("-")
if not slug:
    sys.exit("error: empty slug")
t = L.now()
date, dt = t.strftime("%Y-%m-%d"), t.strftime("%Y-%m-%d_%H-%M-%S")
phase = a.phase
if not phase:
    sp = os.path.join(repo, "PROJECT_STATE.md")
    phase = (L.read_front_matter(sp)[0] or {}).get("phase", "discover") if os.path.exists(sp) else "discover"
tmpl, ddir, pat = L.ARTIFACTS[a.type]
num = 0
if a.type == "adr":
    d = os.path.join(repo, ddir)
    nums = [int(m.group(1)) for f in (os.listdir(d) if os.path.isdir(d) else []) if (m := re.match(r"(\d+)-", f))]
    num = max(nums, default=0) + 1
    aid = "ADR-%04d" % num
else:
    aid = "%s-%s-%s" % (L.ID_PREFIX.get(a.type, a.type.upper()[:5]), t.strftime("%Y%m%d"), slug)
title = a.title or slug.replace("-", " ").capitalize()
with open(L.template_path(repo, tmpl), encoding="utf-8") as f:
    txt = L.fill(f.read(), id=aid, date=date, datetime=t.astimezone().isoformat(timespec="seconds"),
                 agent=a.agent, title=title, phase=phase, commit=L.git(repo, "rev-parse", "--short", "HEAD"),
                 branch=L.git(repo, "branch", "--show-current"), summary=a.summary or title,
                 section=a.section, kind={"plan-review": "plan", "review": "slice"}.get(a.type, "slice"))
if a.type == "changelog":
    p = os.path.join(repo, "CHANGELOG.md")
    cur = open(p, encoding="utf-8").read() if os.path.exists(p) else "# Changelog\n"
    if re.search(r"^## \[Unreleased\]", cur, re.M):
        cur = re.sub(r"^(## \[Unreleased\][^\n]*\n)", lambda m: m.group(1) + txt.rstrip("\n") + "\n\n", cur, count=1, flags=re.M)
    else:
        cur = cur.rstrip("\n") + "\n\n## [Unreleased]\n" + txt
    open(p, "w", encoding="utf-8", newline="\n").write(cur)
    print(p)
    sys.exit(0)
os.makedirs(os.path.join(repo, ddir), exist_ok=True)
p = os.path.join(repo, ddir, pat.format(date=date, datetime=dt, slug=slug, num=num))
if os.path.exists(p):
    sys.exit("error: exists: " + p)
open(p, "w", encoding="utf-8", newline="\n").write(txt)
print(L.rel(p, repo))
